# Salin ke .env lalu isi. Kunci dibuat dengan: make genkey
# Untuk produksi lihat infra/prod.env.example dan docs/deploy.md.

# --- api ---
API_ADDR=:8081
DATABASE_URL=postgres://kamscode:kamscode@localhost:5432/kamscode_meet?sslmode=disable
JOIN_TOKEN_PRIVATE_KEY=
SFU_PUBLIC_URL=ws://localhost:8080/ws
COOKIE_SECURE=false
# Header IP klien dari proxy tepercaya (mis. CF-Connecting-IP). Kosong = alamat koneksi langsung.
CLIENT_IP_HEADER=

# --- sfu ---
SFU_ADDR=:8080
JOIN_TOKEN_PUBLIC_KEY=
SFU_ALLOWED_ORIGINS=localhost:5173
# Opsi A (SFU ber-IP publik): satu port UDP untuk semua media + IP publik yang diumumkan.
SFU_UDP_PORT=
SFU_PUBLIC_IPS=

# --- ICE (dipakai api DAN sfu) ---
# Opsi B (di belakang CGNAT): Cloudflare Realtime TURN. Jika diisi, ICE_URLS diabaikan.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Daftar statis dipisah koma, mis. stun:stun.cloudflare.com:3478 (kosong = tanpa STUN, cukup untuk LAN).
ICE_URLS=
ICE_USERNAME=
ICE_CREDENTIAL=

LOG_LEVEL=info
