# Env produksi untuk stack Swarm (infra/stack.yml). Salin ke infra/prod.env — JANGAN di-commit.
# Semua service dilayani dari SATU domain: https://meet.domain-anda.com
#   /        -> web (Vue)
#   /api/... -> api
#   /ws      -> sfu (WebSocket signaling)

# --- api ---
API_ADDR=:8081
DATABASE_URL=postgres://USER:PASS@192.168.1.xx:5432/kamscode_meet?sslmode=disable
JOIN_TOKEN_PRIVATE_KEY=
SFU_PUBLIC_URL=wss://meet.domain-anda.com/ws
COOKIE_SECURE=true
CLIENT_IP_HEADER=CF-Connecting-IP

# --- sfu ---
SFU_ADDR=:8080
JOIN_TOKEN_PUBLIC_KEY=
SFU_ALLOWED_ORIGINS=meet.domain-anda.com
# Opsi A saja (SFU ber-IP publik):
SFU_UDP_PORT=
SFU_PUBLIC_IPS=

# --- ICE: opsi B (homelab di belakang CGNAT) memakai Cloudflare Realtime TURN ---
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
ICE_URLS=

LOG_LEVEL=info
